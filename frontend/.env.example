# Base URL of the .NET backend on your VPS (no trailing slash).
# In local dev you can leave this empty: Vite proxies /api to localhost:5080.
VITE_API_BASE_URL=https://api.jouwdomein.nl

# Shared household API key; must match AUTH__APIKEY on the VPS.
VITE_API_KEY=

# Authentication (optional)
# Set to "code" for single-code auth, or leave empty to disable
VITE_AUTH_MODE=code
VITE_AUTH_CODE=

# For username/password auth (defaults: marstc / 1901)
VITE_AUTH_USERNAME=marstc
VITE_AUTH_PASSWORD=1901
