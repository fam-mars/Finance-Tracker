# Base URL of the .NET backend on your VPS (no trailing slash).
# In local dev you can leave this empty: Vite proxies /api to localhost:5080.
VITE_API_BASE_URL=

# Shared household API key; must match AUTH__APIKEY on the VPS.
VITE_API_KEY=

# Domeinlogica op de server (feature-flag).
# Staat automatisch AAN zodra VITE_API_BASE_URL gezet is: de app haalt dan
# alle afgeleide cijfers (dashboard, hypotheek, box 3, gezondheid, ...) uit
# POST /api/derive op de VPS en valt bij storing stil terug op lokaal rekenen.
# Zet op "off" om serverberekeningen te forceren uit terwijl de backend wel
# voor opslag gebruikt wordt.
VITE_BACKEND_LOGIC=

# Authentication (optional)
# Leave both VITE_AUTH_MODE and VITE_AUTH_CODE empty to disable login screen
# For code-based access, set:
#   VITE_AUTH_MODE=code
#   VITE_AUTH_CODE=your-secret-code
# For username/password access, set:
#   VITE_AUTH_MODE=credentials
#   VITE_AUTH_USERNAME=marstc
#   VITE_AUTH_PASSWORD=1901
VITE_AUTH_MODE=
VITE_AUTH_CODE=
